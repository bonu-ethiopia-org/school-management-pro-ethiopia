
<!DOCTYPE html>
<html lang="om">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>School Management Pro Ethiopia</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f2f5fa;color:#172b45}
header{background:#12345a;color:white;padding:20px}
nav{background:white;padding:10px;display:flex;flex-wrap:wrap;gap:8px}
nav button,.btn{padding:12px;border:0;border-radius:7px;background:#2167b2;color:white;cursor:pointer}
main{padding:20px;max-width:1100px;margin:auto}
.page{display:none}.page.active{display:block}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.card,.panel{background:white;padding:18px;border-radius:12px;margin:12px 0}
.card strong{display:block;font-size:27px;margin-top:10px}
input,select{padding:12px;border:1px solid #ccd5e0;border-radius:7px;width:100%;margin:5px 0}
form{display:grid;grid-template-columns:1fr 1fr;gap:8px}
table{width:100%;border-collapse:collapse;min-width:450px}
th,td{padding:11px;border-bottom:1px solid #ddd;text-align:left}
.tablebox{overflow-x:auto}
@media(max-width:650px){.cards{grid-template-columns:1fr 1fr}form{grid-template-columns:1fr}main{padding:12px}}
</style>
</head>
<body>

<header>
<h2>School Management Pro Ethiopia</h2>
<p>Sirna bulchiinsa mana barumsaa</p>
</header>

<nav>
<button onclick="showPage('home',this)">Dashboard</button>
<button onclick="showPage('students',this)">Barattoota</button>
<button onclick="showPage('teachers',this)">Barsiisota</button>
<button onclick="showPage('attendance',this)">Argama</button>
<button onclick="showPage('exams',this)">Qormaata</button>
<button onclick="showPage('finance',this)">Kaffaltii</button>
<button onclick="showPage('reports',this)">Gabaasa</button>
</nav>

<main>

<section id="home" class="page active">
<h2>Dashboard</h2>
<div class="cards">
<div class="card">Barattoota<strong id="studentCount">0</strong></div>
<div class="card">Barsiisota<strong id="teacherCount">0</strong></div>
<div class="card">Argama<strong>94%</strong></div>
<div class="card">Mana barumsaa<strong>1</strong></div>
</div>
<div class="panel">
<h3>Baga nagaan dhuftan!</h3>
<p>Sirna kanaan hojii mana barumsaa bulchuu dandeessu.</p>
</div>
</section>

<section id="students" class="page">
<h2>Galmee Barattootaa</h2>
<div class="panel">
<form id="studentForm">
<input id="sName" placeholder="Maqaa barataa" required>
<input id="sId" placeholder="Lakkoofsa galmee" required>
<select id="sGrade" required>
<option value="">Kutaa filadhu</option>
<option>1</option><option>2</option><option>3</option>
<option>4</option><option>5</option><option>6</option>
<option>7</option><option>8</option><option>9</option>
<option>10</option><option>11</option><option>12</option>
</select>
<input id="sPhone" placeholder="Bilbila maatii">
<button class="btn">Barataa galmeessi</button>
</form>
</div>
<div class="panel tablebox">
<table>
<thead><tr><th>Maqaa</th><th>ID</th><th>Kutaa</th><th>Bilbila</th></tr></thead>
<tbody id="studentRows"></tbody>
</table>
</div>
</section>

<section id="teachers" class="page">
<h2>Galmee Barsiisotaa</h2>
<div class="panel">
<form id="teacherForm">
<input id="tName" placeholder="Maqaa barsiisaa" required>
<input id="tSubject" placeholder="Barnoota barsiisu" required>
<input id="tPhone" placeholder="Bilbila">
<button class="btn">Barsiisaa galmeessi</button>
</form>
</div>
<div class="panel tablebox">
<table>
<thead><tr><th>Maqaa</th><th>Barnoota</th><th>Bilbila</th></tr></thead>
<tbody id="teacherRows"></tbody>
</table>
</div>
</section>

<section id="attendance" class="page">
<h2>Hordoffii Argamaa</h2>
<div class="panel">
<input type="date" id="attDate">
<input id="attName" placeholder="Maqaa barataa">
<select id="attStatus">
<option>Argame</option>
<option>Hin argamne</option>
<option>Boqonnaa hayyamame</option>
</select>
<button class="btn" onclick="saveAttendance()">Argama galmeessi</button>
</div>
<div class="panel tablebox">
<table>
<thead><tr><th>Guyyaa</th><th>Barataa</th><th>Haala</th></tr></thead>
<tbody id="attendanceRows"></tbody>
</table>
</div>
</section>

<section id="exams" class="page">
<h2>Qormaataa fi Bu'aa</h2>
<div class="panel">
<form id="examForm">
<input id="eName" placeholder="Maqaa barataa" required>
<input id="eSubject" placeholder="Barnoota" required>
<input id="eScore" type="number" min="0" max="100" placeholder="Qabxii /100" required>
<button class="btn">Bu'aa galmeessi</button>
</form>
</div>
<div class="panel tablebox">
<table>
<thead><tr><th>Barataa</th><th>Barnoota</th><th>Qabxii</th></tr></thead>
<tbody id="examRows"></tbody>
</table>
</div>
</section>

<section id="finance" class="page">
<h2>Kaffaltii Mana Barumsaa</h2>
<div class="panel">
<form id="feeForm">
<input id="fName" placeholder="Maqaa barataa" required>
<input id="fAmount" type="number" min="1" placeholder="Maallaqa ETB" required>
<select id="fType">
<option>Kaffaltii barnootaa</option>
<option>Kaffaltii galmee</option>
<option>Kaffaltii geejjibaa</option>
</select>
<button class="btn">Kaffaltii galmeessi</button>
</form>
</div>
<div class="panel tablebox">
<table>
<thead><tr><th>Barataa</th><th>Gosa</th><th>Maallaqa</th></tr></thead>
<tbody id="feeRows"></tbody>
</table>
</div>
</section>

<section id="reports" class="page">
<h2>Gabaasa</h2>
<div class="panel">
<p>Gabaasa mana barumsaa maxxansi.</p>
<button class="btn" onclick="window.print()">Maxxansi</button>
</div>
</section>

</main>

<script>
function showPage(id,button){
 document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
 document.getElementById(id).classList.add('active');
}

function addRow(tableId,values){
 const row=document.createElement('tr');
 values.forEach(value=>{
  const cell=document.createElement('td');
  cell.textContent=value;
  row.appendChild(cell);
 });
 document.getElementById(tableId).appendChild(row);
}

document.getElementById('studentForm').addEventListener('submit',function(e){
 e.preventDefault();
 addRow('studentRows',[
  document.getElementById('sName').value,
  document.getElementById('sId').value,
  document.getElementById('sGrade').value,
  document.getElementById('sPhone').value
 ]);
 document.getElementById('studentCount').textContent=
 Number(document.getElementById('studentCount').textContent)+1;
 this.reset();
});

document.getElementById('teacherForm').addEventListener('submit',function(e){
 e.preventDefault();
 addRow('teacherRows',[
  document.getElementById('tName').value,
  document.getElementById('tSubject').value,
  document.getElementById('tPhone').value
 ]);
 document.getElementById('teacherCount').textContent=
 Number(document.getElementById('teacherCount').textContent)+1;
 this.reset();
});

function saveAttendance(){
 const date=document.getElementById('attDate').value;
 const name=document.getElementById('attName').value;
 const status=document.getElementById('attStatus').value;
 if(!date||!name){alert('Guyyaa fi maqaa guuti');return;}
 addRow('attendanceRows',[date,name,status]);
 document.getElementById('attName').value='';
}

document.getElementById('examForm').addEventListener('submit',function(e){
 e.preventDefault();
 addRow('examRows',[
  document.getElementById('eName').value,
  document.getElementById('eSubject').value,
  document.getElementById('eScore').value+'/100'
 ]);
 this.reset();
});

document.getElementById('feeForm').addEventListener('submit',function(e){
 e.preventDefault();
 addRow('feeRows',[
  document.getElementById('fName').value,
  document.getElementById('fType').value,
  'ETB '+document.getElementById('fAmount').value
 ]);
 this.reset();
});

document.getElementById('attDate').value=
 new Date().toISOString().slice(0,10);
</script>

</body>
</html>
